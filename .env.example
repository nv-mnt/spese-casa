# ---------------------------------------------------------------------------
# Variabili d'ambiente del progetto "Spese Casa".
# Copiare in `.env` e adattare:  cp .env.example .env
# Lo stesso file viene letto da docker-compose e (per lo sviluppo locale)
# dal backend tramite pydantic-settings.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=spese
POSTGRES_PASSWORD=spese
POSTGRES_DB=spese_casa
POSTGRES_PORT=5432

# --- Backend ----------------------------------------------------------------
# In Docker l'host del database e' il nome del servizio ("db").
# In locale usare: postgresql+asyncpg://spese:spese@localhost:5432/spese_casa
DATABASE_URL=postgresql+asyncpg://spese:spese@db:5432/spese_casa

# Generare una chiave robusta, es.:  openssl rand -hex 32
SECRET_KEY=cambiami-in-produzione-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
SQL_ECHO=False
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Nomi di default dei due membri creati alla registrazione
DEFAULT_HOUSEHOLD_NAME=Casa
DEFAULT_MEMBER_A=Giuseppe
DEFAULT_MEMBER_B=Angela
DEFAULT_CURRENCY=EUR

# --- Frontend ---------------------------------------------------------------
# URL base delle API usato dal client Axios.
# In Docker il frontend e' servito da nginx che fa da proxy su /api -> backend,
# quindi il valore corretto e' il percorso relativo "/api/v1".
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=3000
